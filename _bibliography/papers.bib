@misc{yang2026procedural,
  category        = {philosophy},
  subtopic        = {metaethics},
  abbr            = {Metaethics},
  title           = {Why Should We Care? A Defense of Procedural Realism},
  author          = {Yang, Audrey},
  year            = {2026},
  month           = {May},
  additional_info = {Final essay, Harvard PHIL 173E: Metaethics},
  pdf             = {procedural-realism.pdf},
  abstract        = {I reconstruct and defend Christine Korsgaard's procedural realism. I argue that procedural realism can survive David Enoch's Schmagency objection and can concede the existence of schmagents while retaining its universality and categoricity.}
}

@misc{yang2026street,
  category        = {philosophy},
  subtopic        = {metaethics},
  abbr            = {Metaethics},
  title           = {In Defense of Street's Antirealism},
  author          = {Yang, Audrey},
  year            = {2026},
  month           = {March},
  additional_info = {Midterm paper, Harvard PHIL 173E: Metaethics},
  pdf             = {street-antirealism.pdf},
  abstract        = {In "A Darwinian Dilemma for Realist Theories of Value," Sharon Street challenges moral realists by positing that Darwinian theories of evolution present an inescapable dilemma that makes realism incompatible with natural science. I summarize Street's argument, discuss two objections from Katia Vavova's "Evolutionary Debunking of Moral Realism," and propose a way for Street to successfully defend her view against these objections.}
}

@misc{yang2025happiness,
  category        = {philosophy},
  subtopic        = {literary philosophy},
  abbr            = {Lit. Phil.},
  title           = {The Cost of True Happiness: An Analysis of Diotima Through the Lens of Austen},
  author          = {Yang, Audrey},
  year            = {2025},
  month           = {March},
  additional_info = {Essay, written for fun},
  pdf             = {cost-of-true-happiness.pdf},
  abstract        = {In Plato's Symposium, Socrates presents Diotima's ladder of love, in which progressing up the stages leads the lover to an understanding of virtue and the attainment of happiness. I claim that Jane Austen endorses Diotima's ladder as a path towards virtue and true happiness, but introduces two additions Diotima does not explicitly address: selflessness is a key trait needed to progress up the ladder, and cultivating selflessness requires the potentially painful sacrifice of fleeting, emotional happiness in exchange for true and lasting happiness.}
}

@misc{yang2025sympathy,
  category        = {philosophy},
  subtopic        = {literary philosophy},
  abbr            = {Lit. Phil.},
  title           = {Sympathy: the Key to Character Discernment},
  author          = {Yang, Audrey},
  year            = {2025},
  month           = {May},
  additional_info = {Essay, written for fun},
  pdf             = {sympathy-character-discernment.pdf},
  abstract        = {Jane Austen uses the interaction of characters in her novels to illustrate a method for discerning moral character, and a key part of this process is exercising sympathy, which Adam Smith claims in his Theory of Moral Sentiments allows us to understand the motives behind people's actions. I propose that Austen presents a cyclic model of sympathy and character judgment, where the two inform one another to allow the sympathizer to converge upon an epistemically sound judgment of character, and that her novels serve as a means for readers to practice this model of character discernment.}
}

@misc{yang2024humility,
  category        = {philosophy},
  subtopic        = {epistemology},
  abbr            = {Epistemology},
  title           = {Training Intellectual Humility},
  author          = {Yang, Audrey},
  year            = {2024},
  month           = {May},
  additional_info = {Course paper},
  pdf             = {training-intellectual-humility.pdf},
  abstract        = {I propose an intellectual regimen, a "Confidence Tracker," that practices intellectual humility by exercising one's ability to gauge the appropriate level of confidence in one's beliefs. The regimen is tailored towards people who are easily swayed by external voices, leading to excessive humility and a lack of justified confidence in epistemically sound beliefs, but can also be adapted to reduce overconfidence. It is not meant to simply boost confidence, but to help the person feel confident in the degree of doxastic openness they should hold regarding a belief.}
}

@misc{yang2024grandstanding,
  category        = {philosophy},
  subtopic        = {ethics of technology},
  abbr            = {Ethics & Tech},
  title           = {Take A Stand: Fight Moral Grandstanding on Twitter},
  author          = {Yang, Audrey},
  year            = {2024},
  month           = {March},
  additional_info = {Course paper},
  pdf             = {moral-grandstanding-twitter.pdf},
  abstract        = {Moral grandstanding, the use of moral talk to make oneself appear more virtuous in the eyes of others, is prevalent on social media and exacerbated by the gamification of communication. Drawing on Tosi and Warmke's account of grandstanding and C. Thi Nguyen's analysis of the gamification of Twitter, I examine how the structure of the platform reinforces the psychological drive to grandstand, and propose ways to counter it.}
}
